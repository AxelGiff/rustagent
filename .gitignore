# Rust
/target
**/*.rs.bk

# NOTE: Cargo.lock is intentionally NOT ignored.
# This is an application (not a library), so the lockfile must be committed
# to ensure reproducible builds across environments.

# Generated by Cargo
# will have compiled files and executables
debug/
release/

# These are backup files generated by rustfmt
**/*.rs.bk

# MSVC Windows builds of rustc generate these files, which store debugging information
*.pdb

# macOS
.DS_Store

# IDE / Editor
.idea/
.vscode/
*.swp
*.swo
*~
*.iml

# Logs
*.log

# Environment / secrets
.env
.env.*
!.env.example

# Agent memory
agent_memory.json
*.bak
*.sav

# OS generated files
Thumbs.db
Desktop.ini

# Node (for JS/TS tooling)
node_modules/

# Python
__pycache__/
*.py[cod]
.venv/
venv/
